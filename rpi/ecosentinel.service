[Unit]
Description=EcoSentinel - motor de inferencia IDS (edge, RPi 3A+)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rpi
Group=rpi
WorkingDirectory=/home/rpi/ecosentinel
EnvironmentFile=/home/rpi/ecosentinel/.env.ecosentinel
# Las IPs de confianza NO van aqui: este unit vive en la capa SD (overlayroot),
# asi que cambiarlas obligaria a remontar la SD y reiniciar la RPi. Van en
# ECOSENTINEL_TRUSTED_IPS dentro de .env.ecosentinel, que se edita en caliente.
# Al mover la RPi de red (casa -> laboratorio) el DHCP le da otra IP a la laptop
# de administracion: ahi es donde se actualiza. Si falta, el motor lo avisa en
# el arranque en vez de callarselo.
#
# Misma razon para la interfaz de captura: ECOSENTINEL_LIVE_IFACE en
# .env.ecosentinel (systemd la sustituye aqui via EnvironmentFile). Hoy es
# wlan0 (cliente WiFi: solo ve su propio trafico + broadcast). Si se conecta
# un adaptador USB-Ethernet al puerto SPAN del switch (Fa0/10, ver
# network/topologia-cisco/), cambia esa variable al nombre real de la nueva
# interfaz (`ip link` para verlo, normalmente eth0) y reinicia el servicio —
# sin tocar este unit ni remontar la SD. No hace falta forzar modo
# promiscuo aparte: scapy.sniff() ya abre la interfaz en promiscuo por
# defecto (conf.sniff_promisc=True), y el binario de python ya tiene
# cap_net_raw/cap_net_admin via setcap (ver setup_rpi.sh).
ExecStart=/home/rpi/ecosentinel/.venv/bin/python3 /home/rpi/ecosentinel/inference_engine.py --live ${ECOSENTINEL_LIVE_IFACE}
Restart=on-failure
RestartSec=5
MemoryHigh=300M
MemoryMax=350M

[Install]
WantedBy=multi-user.target
