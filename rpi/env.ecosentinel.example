# Plantilla de /home/rpi/ecosentinel/.env.ecosentinel (el archivo real NO se
# versiona: lleva la API key del dispositivo).
#
#   cp env.ecosentinel.example ~/ecosentinel/.env.ecosentinel
#   chmod 600 ~/ecosentinel/.env.ecosentinel
#
# Lo lee systemd vía EnvironmentFile= (ver ecosentinel.service). Formato de
# systemd: CLAVE=valor, sin `export` y sin comillas alrededor del valor.
# Tras editarlo:  sudo systemctl restart ecosentinel

# URL base del backend en Vercel. Sin barra final.
ECOSENTINEL_API_URL=https://tu-dominio.vercel.app

# API key de ESTE dispositivo (la genera `npm run db:create-device`; en la base
# solo queda su hash). Es un secreto: el archivo va con chmod 600.
ECOSENTINEL_API_KEY=pon-aqui-la-api-key

# IPs de administración a excluir del análisis, separadas por coma.
#
# POR QUÉ ESTÁ AQUÍ Y NO EN EL UNIT DE SYSTEMD: el unit vive en la capa SD
# (overlayroot), así que cambiarlo obliga a remontar la SD y reiniciar la RPi.
# Este archivo no está en esa capa. Y la IP de la laptop de administración
# CAMBIA al mover la RPi de red — el DHCP del laboratorio no le dará la misma
# que en casa.
#
# Sin esto, el propio tráfico SSH con el que administras la RPi alimenta al
# clasificador (ráfagas cortas, nada parecido al benigno IoT de CIC-IoT2023) y
# genera falsos positivos. El motor avisa en el arranque si queda vacío.
#
# OJO: NO excluye el puerto 22 en general — fuerza bruta SSH contra otros hosts
# de la red del cliente se sigue viendo. Solo excluye flujos donde uno de los
# extremos es una de estas IPs.
#
# Y el efecto secundario que hay que recordar en la demo: un ataque lanzado
# DESDE una de estas IPs es invisible a propósito. Para ensayar hace falta un
# segundo dispositivo (el teléfono, otra compu).
ECOSENTINEL_TRUSTED_IPS=192.168.1.75
